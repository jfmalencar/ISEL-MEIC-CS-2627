 * Description  : Interface definitions for calls crossing the enclave boundary.
 */

enclave {
    /* ECALL: operation requested by the untrusted application. */
    trusted {
        public int ecall_hello_message();
    };

    /* OCALL: untrusted service requested by code executing in the enclave. */
    untrusted {
        /* [in, string] copies a NUL-terminated string out of the enclave. */
        void ocall_print_string( [in, string] const char *str );
    };
};
